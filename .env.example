# ===== 必填 =====
# 智谱开放平台“标准 API Key”（不要用个人/团队 Coding Plan 套餐 Key）
# 获取：https://bigmodel.cn/usercenter/proj-mgmt/apikeys
ZHIPU_API_KEY=your_api_key_here

# ===== 可选 =====
# 模型名，默认就是 glm-4v-flash
ZHIPU_MODEL=glm-4v-flash
# 纯文字分析可以单独指定文本模型，不填则沿用 ZHIPU_MODEL
# ZHIPU_TEXT_MODEL=glm-4v-flash

# 鉴权模式：
# auto = Key 包含点号（id.secret）时自动生成 JWT，否则直接用原始 Key（默认）
# jwt  = 强制 JWT，必须使用 id.secret 格式的 Key
# raw  = 强制直接使用原始 Key
ZHIPU_AUTH_MODE=auto

# JWT 有效期（秒），默认 3600
# ZHIPU_JWT_TTL_SECONDS=3600

# 本地端口（Vercel / Render 会自动注入，不要覆盖）
PORT=3000

# 上游地址，一般不需要改
# ZHIPU_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# 上游请求超时（毫秒），默认 25000；Vercel 函数上限已放宽到 30 秒
# ZHIPU_TIMEOUT_MS=25000

# 限流：默认单 IP 每分钟 5 次
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW_MS=60000

# 如果部署在 Cloudflare 等“多一层”反代后面，可设为反代层数，例如 2
# TRUST_PROXY=2
